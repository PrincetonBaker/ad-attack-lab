# Isolated host-only lab. Do NOT bridge to a real network.
BOX = "gusztavvargadr/windows-server-2022-standard"
WS_BOX = "gusztavvargadr/windows-10"
HOSTS = {
  "dc01" => { ip: "192.168.56.10", box: BOX, mem: 4096 },
  "ca01" => { ip: "192.168.56.11", box: BOX, mem: 3072 },
  "ws01" => { ip: "192.168.56.20", box: WS_BOX, mem: 4096 },
}
Vagrant.configure("2") do |config|
  HOSTS.each do |name, h|
    config.vm.define name do |m|
      m.vm.box = h[:box]
      m.vm.hostname = name
      m.vm.communicator = "winrm"
      m.vm.network "private_network", ip: h[:ip]
      m.vm.provider "virtualbox" do |vb|
        vb.memory = h[:mem]
        vb.cpus = 2
        vb.linked_clone = true
      end
    end
  end
end
